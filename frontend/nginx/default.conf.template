# Rendered by the nginx image at startup: ${API_UPSTREAM} comes from the environment.

# Address the client used, which the API needs to build absolute URLs (e.g. the OpenAPI server).
# The container listens on 8080 but is usually published on another port (WEB_PORT), so
# $server_port is not it. If another proxy sits in front (e.g. one terminating HTTPS), keep what
# it sends; otherwise take the scheme from this request and host:port from its Host header.
map $http_x_forwarded_proto $client_proto {
    ''      $scheme;
    default $http_x_forwarded_proto;
}
map $http_x_forwarded_host $client_host {
    ''      $http_host;
    default $http_x_forwarded_host;
}
map $client_proto $client_default_port {
    https   443;
    default 80;
}
# Port from X-Forwarded-Port, else from "host:port", else the scheme's default port.
map "$http_x_forwarded_port|$client_host" $client_port {
    "~^(?<p>\d+)\|"      $p;
    "~^\|.*:(?<p>\d+)$"  $p;
    default              $client_default_port;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Liveness of the web container itself (used by the Docker healthcheck).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Backend: API, actuator and OpenAPI all live under /api.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        proxy_set_header X-Forwarded-Host $client_host;
        proxy_set_header X-Forwarded-Port $client_port;
        # Room for CSV imports, and time: a large file takes longer than the default minute.
        client_max_body_size 20m;
        proxy_read_timeout 300s;
    }

    # Hashed build assets never change: cache them for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths are client-side routes.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
