# Variables of the demo (docker-compose.demo.yml), used instead of .env:
#
#   docker compose -p poker-bankroll-demo -f docker-compose.yml -f docker-compose.demo.yml --env-file demo.env up -d
#
# The project and the files go on the command line, never here or in the shell: they take
# precedence over anything else, so `down -v` can never reach a real installation.

# Port of the host where the demo is served (http://localhost:8081). A WEB_PORT variable of the
# shell takes precedence over this one.
WEB_PORT=8081

# A throwaway password for a database of made-up data. Never use it for a real installation.
POSTGRES_PASSWORD=demo

# The demo has its own made-up exchange rates.
EXCHANGE_RATES_ENABLED=false

# The demo takes no backups; if its backup service were started anyway, never into the folder of
# the backups of a real installation.
BACKUP_DIR=./demo-backups
