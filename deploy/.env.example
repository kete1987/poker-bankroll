# Copy to .env next to docker-compose.yml and adjust. In Portainer, set these as stack variables.

# Images to run from GHCR: "latest" (last stable release), an exact version (e.g. 0.2.1),
# a series (e.g. 0.2, fixes only) or "edge" (last merge to main). See docs/releasing.md.
POKER_BANKROLL_VERSION=latest

# Port of the host where the app is served (http://<host>:WEB_PORT).
WEB_PORT=8080

# Exchange rates of the ECB, downloaded by the API from https://api.frankfurter.dev (outgoing
# internet access) to show amounts of several currencies together. false: never downloaded, only
# the rates typed by hand in Settings → Currencies. See docs/currencies.md.
EXCHANGE_RATES_ENABLED=true

# Optional MCP for Codex, Claude Code and other Streamable HTTP clients (read-only by default).
# Runs in the existing API container at http://<host>:WEB_PORT/api/mcp. Disabled by default.
# Generate a separate random token of 32+ URL-safe characters before enabling; never commit it.
MCP_ENABLED=false
# Enables seven write tools for every client with MCP_TOKEN. Requires MCP_ENABLED=true.
# False keeps reads available and hides/rejects all writes. See docs/mcp.md before enabling.
MCP_WRITE_ENABLED=false
MCP_TOKEN=
# Exact browser origins, comma separated, without a path or trailing slash. Empty: reject any
# Origin header (native CLI clients normally send none). Tokens are required in either case.
MCP_ALLOWED_ORIGINS=

# Database. The password is required; choose a long random one.
POSTGRES_DB=pokerbankroll
POSTGRES_USER=pokerbankroll
POSTGRES_PASSWORD=change-me

# Database backups (see docs/backups.md). A dump is taken on start and then on BACKUP_SCHEDULE.
# Host folder for the dumps. Relative paths are resolved next to docker-compose.yml; in
# Portainer use an absolute host path (e.g. /srv/poker-bankroll/backups).
BACKUP_DIR=./backups
# When to back up: @daily (midnight), @every 6h or a cron expression such as 30 3 * * *
# (every day at 03:30), evaluated in the BACKUP_TZ time zone (e.g. Europe/Madrid).
BACKUP_SCHEDULE=@daily
BACKUP_TZ=UTC
# How many daily, weekly and monthly dumps to keep.
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
# user:group the backup container runs as. 0:0 (root) can write to a folder created by Docker.
# To have the files owned by a regular user, create BACKUP_DIR owned by that user first and
# set its ids (e.g. 1000:1000).
BACKUP_USER=0:0
