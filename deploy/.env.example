# Copy to .env next to docker-compose.yml and adjust. In Portainer, set these as stack variables.

# Images to run from GHCR: a release version (e.g. 0.1.0) or "latest".
POKER_BANKROLL_VERSION=latest

# Port of the host where the app is served (http://<host>:WEB_PORT).
WEB_PORT=8080

# Database. The password is required; choose a long random one.
POSTGRES_DB=pokerbankroll
POSTGRES_USER=pokerbankroll
POSTGRES_PASSWORD=change-me

# Database backups (see docs/backups.md). A dump is taken on start and then on BACKUP_SCHEDULE.
# Host folder for the dumps. Relative paths are resolved next to docker-compose.yml; in
# Portainer use an absolute host path (e.g. /srv/poker-bankroll/backups).
BACKUP_DIR=./backups
# When to back up: @daily (midnight), @every 6h or a cron expression such as 30 3 * * *
# (every day at 03:30), evaluated in the BACKUP_TZ time zone (e.g. Europe/Madrid).
BACKUP_SCHEDULE=@daily
BACKUP_TZ=UTC
# How many daily, weekly and monthly dumps to keep.
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
# user:group the backup container runs as. 0:0 (root) can write to a folder created by Docker.
# To have the files owned by a regular user, create BACKUP_DIR owned by that user first and
# set its ids (e.g. 1000:1000).
BACKUP_USER=0:0
